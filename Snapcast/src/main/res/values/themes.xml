<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="statusBarBackground">?attr/colorPrimaryDark</item>
        <!-- Only MainActivity handles window insets; opt the rest of the app out of the
             edge-to-edge enforcement Android 15 (API 35) applies by default, which otherwise
             draws content (e.g. ClientSettingsActivity, GroupSettingsActivity, AboutActivity)
             underneath the status bar. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
